{
  "name": "masar",
  "private": true,
  "version": "0.1.0",
  "description": "Masar (\u0645\u0633\u0627\u0631): a bilingual task workspace for government departments.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @masar/shared build && pnpm --filter @masar/api --filter @masar/web build",
    "dev": "pnpm --filter @masar/shared build && pnpm --parallel --filter @masar/api --filter @masar/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @masar/web test:e2e",
    "db:migrate": "pnpm --filter @masar/api db:migrate",
    "db:seed": "pnpm --filter @masar/api db:seed",
    "db:reset": "pnpm --filter @masar/api db:reset"
  }
}
