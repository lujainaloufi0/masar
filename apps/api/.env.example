# Local development. Copy to apps/api/.env
DATABASE_URL=postgresql://masar:masar@localhost:5432/masar
# Any long random string for development, e.g.  openssl rand -base64 48
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
DEMO_MODE=true
DEMO_RESET_CRON="0 3 * * *"
TZ=Asia/Riyadh
# Optional: Ask Masar, the AI assistant. Leave AI_API_KEY empty to switch it off.
AI_API_KEY=
# anthropic (default) or openai (any OpenAI-compatible service; set AI_BASE_URL for non-OpenAI hosts)
AI_PROVIDER=anthropic
AI_MODEL=
AI_BASE_URL=
AI_DAILY_LIMIT=60
