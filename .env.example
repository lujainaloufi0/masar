# Used by docker-compose.yml. Copy to .env and change the values. Never commit .env.
# A long random string, e.g. the output of:  openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=masar
# The address people open in the browser
WEB_ORIGIN=http://localhost:8080
# true on the public demo: one-click demo accounts and a nightly data reset
DEMO_MODE=true
DEMO_RESET_CRON="0 3 * * *"
TZ=Asia/Riyadh
# Optional: Ask Masar, the AI assistant. Leave AI_API_KEY empty to switch it off.
AI_API_KEY=
# anthropic (default) or openai (any OpenAI-compatible service; set AI_BASE_URL for non-OpenAI hosts)
# Google Gemini: AI_PROVIDER=openai, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=anthropic
AI_MODEL=
AI_BASE_URL=
AI_DAILY_LIMIT=60
