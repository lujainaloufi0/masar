# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://masar:masar@localhost:5432/masar
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# Where the web app is served (used for CORS and cookies)
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# true on the public demo: enables one-click demo sign-in and the nightly data reset
DEMO_MODE=true
# Cron for the nightly reset (server time zone is set with TZ)
DEMO_RESET_CRON="0 3 * * *"
TZ=Asia/Riyadh
# Web app: where Next.js forwards /api and /socket.io in development
API_INTERNAL_URL=http://localhost:4000
